    "@google/generative-ai": "^0.24.1",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/websockets": "^10.4.22",
    "@types/d3": "^7.4.3",
    "@types/jsdom": "^27.0.0",
    "@types/socket.io": "^3.0.1",
    "@visactor/vchart": "^2.0.15",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.13.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "jsdom": "^27.4.0",
    "nestjs-zod": "^3.0.0",
    "openai": "^6.21.0",
    "p-limit": "^3.1.0",
    "pg": "^8.19.0",
    "playwright": "^1.58.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "tree-kill": "^1.2.2",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.18.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  }
