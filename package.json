{
  "name": "visualization-project",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "postinstall": "playwright install chromium",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main.js",
    "start:runtime": "node tools/start-runtime.js",
    "start:dev": "node tools/start-with-clip.js start:app:dev",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "start:app": "nest start",
    "start:app:dev": "nest start --watch",
    "start:app:prod": "node dist/main.js",
    "start:worker": "node dist/worker/main.js",
    "start:worker:runtime": "node tools/start-worker-runtime.js",
    "start:worker:dev": "ts-node -r tsconfig-paths/register src/worker/main.ts",
    "start:all": "node tools/start-all.js",
    "start:clip-scorer": "node tools/clip-scorer/server.js",
    "start:image-quality-control": "node tools/image-quality-control/server.js",
    "start:dev:with-clip": "node tools/start-dev-with-clip.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
