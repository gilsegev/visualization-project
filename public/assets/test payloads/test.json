                                                   "visualizationId":  "3.2",
                                                   "title":  "Common Cognitive Distortions -- A Reference Guide",
                                                   "type":  "grid_reference_card",
                                                   "dimensions":  {
                                                                      "width":  1050,
                                                                      "height":  650,
                                                                      "orientation":  "landscape"
