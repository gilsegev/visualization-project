                                                   "distortions":  [
                                                                       {
                                                                           "name":  "All-or-Nothing Thinking",
                                                                           "definition":  "Seeing everything in black and white, with no middle ground.",
                                                                           "example":  "I got a B+, not an A. I\u0027m a total failure."
                                                                       },
                                                                       {
                                                                           "name":  "Catastrophizing",
                                                                           "definition":  "Jumping to the worst possible outcome.",
                                                                           "example":  "This headache must mean something is seriously wrong with me."
                                                                       },
                                                                       {
                                                                           "name":  "Overgeneralization",
                                                                           "definition":  "One bad event becomes a never-ending pattern.",
                                                                           "example":  "One bad date means I\u0027ll never find a partner."
                                                                       },
                                                                       {
                                                                           "name":  "Mental Filter",
                                                                           "definition":  "Fixating on negatives while filtering out positives.",
                                                                           "example":  "9 people smiled at my talk, but I can only think about the 1 who yawned."
                                                                       },
                                                                       {
                                                                           "name":  "Mind Reading",
                                                                           "definition":  "Assuming you know what others think -- usually the worst.",
                                                                           "example":  "She didn\u0027t say hello, so she must dislike me."
                                                                       },
                                                                       {
                                                                           "name":  "Disqualifying the Positive",
                                                                           "definition":  "Dismissing good things as flukes or irrelevant.",
                                                                           "example":  "They only praised my work to be polite."
                                                                       },
                                                                       {
                                                                           "name":  "Personalization",
                                                                           "definition":  "Blaming yourself for things outside your control.",
                                                                           "example":  "The party was quiet -- it must be my fault."
                                                                       }
                                                                   ],
                                                   "summaryNote":  "Everyone experiences these from time to time. The goal isn\u0027t to never have distorted thoughts -- it\u0027s to notice them and ask: \u0027Is this thought a fact, or a habit?\u0027",
                                                   "styling":  {
                                                                   "infographic_theme_id":  "tidepool_contrast"
                                                               }
                                               }
