GEMINI_API_KEY=
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=black-forest-labs/FLUX.1-schnell
SILICONFLOW_STORY_MODEL=black-forest-labs/FLUX.1-schnell
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
PIXABAY_API_KEY=
SOURCED_IMAGE_PROVIDER=unsplash

SOURCED_IMAGE_DISABLE_CLIP=false
SOURCED_IMAGE_DISABLE_VISION=false

CLIP_SCORER_URL=http://127.0.0.1:4310
CLIP_SCORER_USE_LOCAL_FALLBACK=false
IQC_URL=http://127.0.0.1:4310
QUALITY_CONTROL_TIMEOUT_MS=12000

D2_BIN=d2
D2_RENDER_TIMEOUT_MS=5000

# Postgres unified storage layer (production-readiness phase)
POSTGRES_ENABLED=false
DATABASE_URL=
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=visualization
INITIAL_ADMIN_KEY=
INITIAL_ADMIN_EMAIL=admin@local
INITIAL_ADMIN_NAME=Initial Admin

# Durable queue (PostgreSQL-backed)
DURABLE_QUEUE_ENABLED=true
DURABLE_QUEUE_POLL_MS=1000
DURABLE_QUEUE_LEASE_SECONDS=120
DURABLE_QUEUE_HEARTBEAT_MS=10000
DURABLE_QUEUE_STALE_MINUTES=10
DURABLE_QUEUE_JANITOR_EVERY_MS=60000
DURABLE_QUEUE_RETRY_DELAY_SECONDS=30
DURABLE_QUEUE_MAX_ATTEMPTS=3
WORKER_COUNT=1
WORKER_TASK_CONCURRENCY=1
WORKER_HEARTBEAT_MS=10000
WORKER_TIMEOUT_MS=120000
WORKER_SUPERVISOR_ENABLED=true
WORKER_SUPERVISOR_POLL_MS=10000
PLAYWRIGHT_PREWARM=false
WORKER_HEARTBEAT_RETENTION_MINUTES=60
WORKER_HEARTBEAT_SHOW_DEAD_MINUTES=0
WORKER_JANITOR_PURGE_EVERY_MS=300000
QUOTA_SOURCED_IMAGE=100
QUOTA_GENERATED_IMAGE=20
QUOTA_CHART=50
QUOTA_INFOGRAPHIC=10
OBS_LIVE_STATS_ENABLED=true
OBS_LIVE_STATS_MS=5000
OBS_LIVE_STATS_MIN_EMIT_MS=1000

# Rate limiting + cost controls (section 6)
# Asset-based API limiter: manifest/generate requests are charged by asset count.
API_RATE_LIMIT_PER_MINUTE=120
TASK_COST_STORY_IMAGE_USD=0.02
TASK_COST_SOURCED_IMAGE_USD=0.03
TASK_COST_DATA_VIZ_USD=0.01
TASK_COST_INFOGRAPHIC_USD=0.01

# Input validation + payload limits (critical hardening)
MAX_REQUEST_BODY_MB=2
MAX_LESSONS_PER_REQUEST=20
MAX_VISUALIZATIONS_PER_LESSON=20
MAX_TEXT_FIELD_LENGTH=4000
